<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShieldFlow Proxy | Control Surface</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts: Newsreader (Claude Serif), Plus Jakarta Sans, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet" />

    <style>
        /* Claude-inspired color tokens with Bootstrap 5.3 */
        [data-bs-theme="light"] {
            --bs-body-bg: #FAF9F5;
            --bs-body-color: #1F1E1B;
            --bs-card-bg: #FFFFFF;
            --bs-border-color: #E8E4DC;
            --terracotta: #CC5A36;
            --terracotta-hover: #B84B29;
            --terracotta-soft: rgba(204, 90, 54, 0.08);
            --terracotta-border: rgba(204, 90, 54, 0.25);
            --olive-bg: rgba(62, 131, 93, 0.1);
            --olive-text: #2D6A4F;
            --olive-border: rgba(62, 131, 93, 0.28);
        }

        [data-bs-theme="dark"] {
            --bs-body-bg: #181715;
            --bs-body-color: #EEEAE3;
            --bs-card-bg: #22211D;
            --bs-border-color: #33322C;
            --terracotta: #D97757;
            --terracotta-hover: #E38668;
            --terracotta-soft: rgba(217, 119, 87, 0.14);
            --terracotta-border: rgba(217, 119, 87, 0.32);
            --olive-bg: rgba(56, 161, 105, 0.15);
            --olive-text: #52C785;
            --olive-border: rgba(56, 161, 105, 0.32);
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .font-serif {
            font-family: 'Newsreader', Georgia, serif;
        }

        .text-terracotta {
            color: var(--terracotta) !important;
        }

        .bg-terracotta-soft {
            background-color: var(--terracotta-soft) !important;
        }

        .border-terracotta {
            border-color: var(--terracotta-border) !important;
        }

        .btn-terracotta {
            background-color: var(--terracotta);
            color: #ffffff;
            border: none;
            transition: all 0.2s ease-in-out;
        }

        .btn-terracotta:hover {
            background-color: var(--terracotta-hover);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(204, 90, 54, 0.35);
        }

        .status-badge-active {
            background-color: var(--olive-bg);
            color: var(--olive-text);
            border: 1px solid var(--olive-border);
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: currentColor;
            display: inline-block;
        }

        .port-metric-box {
            background: var(--terracotta-soft);
            border: 1px solid var(--terracotta-border);
        }

        .claude-symbol {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--terracotta-soft);
            color: var(--terracotta);
            border: 1px solid var(--terracotta-border);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            transition: transform 0.25s ease;
        }

        .claude-symbol:hover {
            transform: rotate(45deg);
        }
    </style>
</head>

<body>
    <div class="container py-4" style="max-width: 950px;">
        <!-- Top Navigation Bar -->
        <header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
            <div class="d-flex align-items-center gap-2 text-decoration-none">
                <span class="claude-symbol">✦</span>
                <span class="font-serif fs-4 fw-medium text-body">ShieldFlow</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill status-badge-active px-3 py-2 d-inline-flex align-items-center gap-2">
                    <span class="badge-dot"></span>
                    <span>Engine Active</span>
                </span>

                <button id="themeToggleBtn"
                    class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2"
                    onclick="toggleTheme()" title="Switch Theme">
                    <span id="themeIcon">🌙</span>
                    <span id="themeLabel">Espresso</span>
                </button>
            </div>
        </header>

        <!-- Main Hero Card -->
        <main class="card shadow-sm border rounded-4 py-3 px-4 py-lg-3 px-lg-4 mb-3">
            <div class="row align-items-center g-3">
                <!-- Left Column: Primary Heading & Secondary Sub-heading -->
                <div class="col-lg-7 col-md-6">
                    <div class="d-inline-flex align-items-center gap-2 mb-1 text-terracotta fw-semibold small text-uppercase"
                        style="letter-spacing: 0.08em; font-size: 0.725rem;">
                        <span>✦</span> Central Control Surface
                    </div>

                    <h1 class="display-6 fw-normal font-serif text-body-emphasis mb-2">
                        ShieldFlow <em class="text-terracotta fst-italic">Proxy</em>
                    </h1>

                    <!-- Secondary Heading converted from sub-heading -->
                    <h2 class="h6 fw-normal text-secondary lh-base mb-0" style="font-size: 0.925rem;">
                        Central control surface for HTTP(S) filtering and domain blocking. Designed for quiet
                        reliability and zero-trust perimeter control.
                    </h2>
                </div>

                <!-- Right Column: Prominently Shown Ports & Connection Stats -->
                <div class="col-lg-5 col-md-6">
                    <div class="card port-metric-box rounded-3 py-2 px-3 shadow-xs">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold text-uppercase text-terracotta"
                                style="letter-spacing: 0.05em; font-size: 0.725rem;">
                                <i class="bi bi-hdd-network me-1"></i> Proxy Port
                            </span>
                            <span
                                class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-0 small"
                                style="font-size: 0.7rem;">
                                <span class="badge-dot me-1"></span> Online
                            </span>
                        </div>

                        <!-- Enforced Port Display -->
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fs-2 fw-bold font-monospace text-body">:<%= typeof PROXY_PORT !=='undefined' ?
                                    PROXY_PORT : 3128 %></span>
                            <span class="badge rounded-pill bg-body text-secondary border px-2 py-0 small">TCP</span>
                        </div>

                        <!-- Secondary Metric Badges -->
                        <div class="d-flex flex-wrap gap-2 pt-2 border-top border-terracotta">
                            <div
                                class="badge rounded-pill bg-body text-body border px-2 py-1 d-inline-flex align-items-center gap-1 small">
                                <i class="bi bi-shield-x text-terracotta"></i>
                                <span>Blocklist:</span>
                                <strong class="text-terracotta ms-1 dynamic-rule-count">6 active</strong>
                            </div>

                            <div
                                class="badge rounded-pill bg-body text-body border px-2 py-1 d-inline-flex align-items-center gap-1 small">
                                <i class="bi bi-lock text-secondary"></i>
                                <span>Filtering:</span>
                                <strong class="ms-1">HTTP & CONNECT 443</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Blocklist Table -->
        <section id="blockListSection" class="card shadow-sm border rounded-4 p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div class="d-flex align-items-baseline gap-2">
                    <h3 class="h4 font-serif text-body mb-0">Blocked Domain Addresses</h3>
                    <span id="enforcedCountBadge"
                        class="badge rounded-pill bg-terracotta-soft text-terracotta border border-terracotta px-2 py-1 small fw-semibold">
                        <%= typeof totalBlocked !== 'undefined' ? totalBlocked : 6 %> Enforced
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2 flex-nowrap ms-auto">
                    <!-- Bootstrap Search Input -->
                    <div class="input-group input-group-sm rounded-pill flex-nowrap" style="width: 210px; min-width: 160px;">
                        <span
                            class="input-group-text bg-body-tertiary border-end-0 rounded-start-pill ps-3 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="domainSearch"
                            class="form-control bg-body-tertiary border-start-0 rounded-end-pill pe-3"
                            placeholder="Search domains or IPs..." oninput="filterDomains()" />
                    </div>

                    <!-- Link to Architecture Matrix -->
                    <a href="/matrix"
                        class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 text-nowrap shadow-xs">
                        <i class="bi bi-diagram-3 text-terracotta"></i>
                        <span>Architecture Matrix</span>
                    </a>

                    <!-- Add New Domain Button inside Table Header -->
                    <button
                        class="btn btn-sm btn-terracotta rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-2 text-nowrap shadow-xs"
                        data-bs-toggle="modal" data-bs-target="#addDomainModal">
                        <i class="bi bi-plus-lg"></i>
                        <span>Add New Domain</span>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-uppercase text-secondary" style="letter-spacing: 0.05em;">
                            <th scope="col" style="width: 50px;">#</th>
                            <th scope="col">User Name</th>
                            <th scope="col">IP Address</th>
                            <th scope="col">Blocked Domain</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody id="domainTableBody">
                        <!-- Populated dynamically via JS & localStorage -->
                    </tbody>
                </table>

                <div id="emptySearch" class="text-center py-5 text-secondary" style="display: none;">
                    <i class="bi bi-search fs-3 text-secondary d-block mb-2"></i>
                    No matching blocked domains found.
                </div>
            </div>
        </section>

        <!-- Minimalist Footer -->
        <footer
            class="d-flex justify-content-between align-items-center py-3 my-4 border-top text-secondary small flex-wrap gap-2">
            <span>ShieldFlow Proxy &bull; High-Throughput Domain Firewall</span>
            <span class="font-monospace">Port :<%= typeof PROXY_PORT !=='undefined' ? PROXY_PORT : 3128 %></span>
        </footer>
    </div>

    <!-- Bootstrap Modal: Add New Domain -->
    <div class="modal fade" id="addDomainModal" tabindex="-1" aria-labelledby="addDomainModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border rounded-4 shadow-lg p-3">
                <div class="modal-header border-bottom pb-3">
                    <div>  
                        <h5 class="modal-title font-serif fs-4 mb-1 text-body" id="addDomainModalLabel">Add New Blocked
                            Domain</h5>
                        <p class="text-secondary small mb-0">Enter user identity, IP address, and target domain to
                            block.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form id="addDomainForm" onsubmit="handleAddDomain(event)">
                    <div class="modal-body py-3">
                        <!-- Field 1: UserName -->
                        <div class="mb-3">
                            <label for="modalUserName" class="form-label small fw-semibold text-body">User Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary text-secondary"><i
                                        class="bi bi-person"></i></span>
                                <input type="text" class="form-control" id="modalUserName"
                                    placeholder="e.g. Admin" required />
                            </div>
                        </div>

                        <!-- Field 2: IP Address -->
                        <div class="mb-3">
                            <label for="modalIpAddress" class="form-label small fw-semibold text-body">IP
                                Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary text-secondary font-monospace"><i
                                        class="bi bi-hdd-network"></i></span>
                                <input type="text" class="form-control font-monospace" id="modalIpAddress"
                                    placeholder="e.g. 192.168.1.105"
                                    pattern="^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$|^[a-fA-F0-9:]+$"
                                    title="Please enter a valid IP address" required />
                            </div>
                        </div>

                        <!-- Field 3: Domain -->
                        <div class="mb-3">
                            <label for="modalDomain" class="form-label small fw-semibold text-body">Domain</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body-tertiary text-secondary font-monospace"><i
                                        class="bi bi-globe"></i></span>
                                <input type="text" class="form-control font-monospace" id="modalDomain"
                                    placeholder="e.g. www.blocked-site.com" required />
                            </div>
                            <div class="form-text small">Enter domain with or without http(s) prefix.</div>
                        </div>
                    </div>

                    <div class="modal-footer border-top pt-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4"
                            data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="saveDomainBtn"
                            class="btn btn-terracotta rounded-pill px-4 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle"></i>
                            <span>Save Domain</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Embedded JSON Data from Server -->
    <script type="application/json" id="serverBlockedDomainsData">
        <%- JSON.stringify(typeof blockedDomains !== 'undefined' ? blockedDomains : []) %>
    </script>

    <script>
        // Safely parse server-injected blocked domains (eliminates IDE syntax errors)
        const serverBlockedDomains = (() => {
            try {
                const el = document.getElementById('serverBlockedDomainsData');
                return el ? JSON.parse(el.textContent.trim()) : [];
            } catch (e) {
                return [];
            }
        })();
        
        // Base static rules generated directly from proxy.config.ts
        const staticConfigRules = (serverBlockedDomains && serverBlockedDomains.length > 0)
            ? serverBlockedDomains.map((domain, index) => ({
                userName: index % 2 === 0 ? 'System Policy' : 'SecOps Admin',
                ipAddress: '192.168.1.' + (10 + (index + 1) * 7),
                domain: domain,
                isStatic: true
            }))
            : [
                { userName: 'System Policy', ipAddress: '192.168.1.10', domain: 'www.instagram.com', isStatic: true },
                { userName: 'System Policy', ipAddress: '192.168.1.15', domain: 'www.tiktok.com', isStatic: true },
                { userName: 'SecOps Admin', ipAddress: '192.168.1.22', domain: 'www.facebook.com', isStatic: true },
                { userName: 'Compliance Team', ipAddress: '192.168.1.45', domain: 'www.wisden.com', isStatic: true },
                { userName: 'SecOps Admin', ipAddress: '192.168.1.52', domain: 'arena.ai', isStatic: true },
                { userName: 'System Policy', ipAddress: '192.168.1.65', domain: 'angularspace.com', isStatic: true }
            ];

        // Retrieve all rules: custom rules added by user + all static config rules
        function getStoredRules() {
            let customRules = [];
            try {
                const stored = localStorage.getItem('shieldflow_custom_rules');
                if (stored) {
                    customRules = JSON.parse(stored);
                }
            } catch (e) {}

            // Filter out any custom rule that duplicates a static rule domain
            const staticDomains = new Set(staticConfigRules.map(r => r.domain.toLowerCase()));
            const uniqueCustom = customRules.filter(r => !staticDomains.has(r.domain.toLowerCase()));

            return [...uniqueCustom, ...staticConfigRules];
        }

        function saveCustomRules(customRules) {
            localStorage.setItem('shieldflow_custom_rules', JSON.stringify(customRules));
        }

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderTable(filterQuery = '') {
            const rules = getStoredRules();
            const tbody = document.getElementById('domainTableBody');
            const emptyState = document.getElementById('emptySearch');

            // Update badge counts in Hero and Table header
            document.querySelectorAll('.dynamic-rule-count').forEach(b => {
                b.innerText = rules.length + ' active';
            });
            const enforcedBadge = document.getElementById('enforcedCountBadge');
            if (enforcedBadge) {
                enforcedBadge.innerText = rules.length + ' Enforced';
            }

            const q = filterQuery.toLowerCase().trim();
            const filtered = rules.filter(r =>
                !q ||
                r.domain.toLowerCase().includes(q) ||
                r.userName.toLowerCase().includes(q) ||
                r.ipAddress.toLowerCase().includes(q)
            );

            if (filtered.length === 0) {
                tbody.innerHTML = '';
                emptyState.style.display = 'block';
                return;
            }

            emptyState.style.display = 'none';
            tbody.innerHTML = filtered.map((item, idx) => `
                <tr data-domain="${escapeHtml(item.domain.toLowerCase())}">
                    <td class="font-monospace text-secondary small">#${String(idx + 1).padStart(2, '0')}</td>
                    <td>
                        <div class="d-inline-flex align-items-center gap-2">
                            <span class="badge rounded-circle bg-body-secondary text-secondary p-1">
                                <i class="bi bi-person-fill small"></i>
                            </span>
                            <span class="fw-medium text-body">${escapeHtml(item.userName)}</span>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-body-secondary text-secondary font-monospace border px-2 py-1">
                            <i class="bi bi-hdd-network me-1"></i>${escapeHtml(item.ipAddress)}
                        </span>
                    </td>
                    <td>
                        <div class="d-inline-flex align-items-center gap-2">
                            <span class="text-terracotta">✦</span>
                            <span class="font-monospace fw-medium text-body">${escapeHtml(item.domain)}</span>
                        </div>
                    </td>
                    <td>
                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                            <span class="badge-dot me-1"></span> Blocked
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1 align-items-center">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" onclick="copyDomain('${escapeHtml(item.domain)}', this)" title="Copy Domain">
                                <span class="copy-text">Copy</span>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-circle p-0" style="width: 28px; height: 28px;" onclick="deleteRule(${idx})" title="Delete rule">
                                <i class="bi bi-trash small"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Add New Domain Form Handler
        function handleAddDomain(event) {
            event.preventDefault();
            const userNameInput = document.getElementById('modalUserName');
            const ipAddressInput = document.getElementById('modalIpAddress');
            const domainInput = document.getElementById('modalDomain');

            const userName = userNameInput.value.trim();
            const ipAddress = ipAddressInput.value.trim();
            let domain = domainInput.value.trim();

            // Normalize domain (strip http:// or https:// if provided)
            domain = domain.replace(/^https?:\/\//i, '').replace(/\/.*$/, '');

            if (!userName || !ipAddress || !domain) {
                alert('Please enter UserName, IP Address, and Domain.');
                return;
            }

            let customRules = [];
            try {
                const stored = localStorage.getItem('shieldflow_custom_rules');
                if (stored) customRules = JSON.parse(stored);
            } catch (e) {}

            // Prepend new domain to custom rules
            customRules.unshift({ userName, ipAddress, domain, isStatic: false });
            saveCustomRules(customRules);

            // Re-render table
            renderTable();

            // Reset form
            document.getElementById('addDomainForm').reset();

            // Close Bootstrap Modal
            const modalEl = document.getElementById('addDomainModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }

            // Scroll to table
            const section = document.getElementById('blockListSection');
            if (section) {
                section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        // Delete rule handler
        function deleteRule(index) {
            const allRules = getStoredRules();
            const target = allRules[index];
            if (!target) return;

            if (confirm('Are you sure you want to remove ' + target.domain + '?')) {
                if (target.isStatic) {
                    alert('Note: ' + target.domain + ' is configured in server config (proxy.config.ts). To remove it permanently, update proxy.config.ts.');
                }
                let customRules = [];
                try {
                    const stored = localStorage.getItem('shieldflow_custom_rules');
                    if (stored) customRules = JSON.parse(stored);
                } catch (e) {}
                customRules = customRules.filter(r => r.domain.toLowerCase() !== target.domain.toLowerCase());
                saveCustomRules(customRules);
                renderTable();
            }
        }

        // Theme Management using Bootstrap data-bs-theme
        function initTheme() {
            const savedTheme = localStorage.getItem('shieldflow_theme') || 'light';
            applyTheme(savedTheme);
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem('shieldflow_theme', theme);

            const themeIcon = document.getElementById('themeIcon');
            const themeLabel = document.getElementById('themeLabel');

            if (theme === 'dark') {
                themeIcon.innerText = '☀️';
                themeLabel.innerText = 'Cream';
            } else {
                themeIcon.innerText = '🌙';
                themeLabel.innerText = 'Espresso';
            }
        }

        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
            const nextTheme = current === 'light' ? 'dark' : 'light';
            applyTheme(nextTheme);
        }

        // Live Domain Search
        function filterDomains() {
            const query = document.getElementById('domainSearch').value;
            renderTable(query);
        }

        // Copy Domain to Clipboard with Smooth Feedback
        function copyDomain(domain, btn) {
            navigator.clipboard.writeText(domain).then(() => {
                const textSpan = btn.querySelector('.copy-text');
                const prev = textSpan.innerText;
                textSpan.innerText = 'Copied';
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-outline-success');

                setTimeout(() => {
                    textSpan.innerText = prev;
                    btn.classList.remove('btn-outline-success');
                    btn.classList.add('btn-outline-secondary');
                }, 1500);
            });
        }

        // Initialize table and theme on load
        initTheme();
        renderTable();
    </script>
</body>

</html>