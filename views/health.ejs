<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>

    </title>

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
        }

        h1 {
            color: #000000;
        }

        .cards {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .card {
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .15);
            min-width: 180px;
            text-align: center;
        }

        /* Scrollable Table */
        .table-container {
            max-height: 560px;
            /* Around 10 rows */
            overflow-y: auto;
            overflow-x: auto;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: white;
        }

        table {
            width: 100%;
            min-width: 1500px;
            /* Enables horizontal scrolling if needed */
            border-collapse: collapse;
        }

        thead th {
            position: sticky;
            top: 0;
            background: #34495e;
            color: white;
            z-index: 10;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
            white-space: nowrap;
            /* Prevent text wrapping */
        }

        tbody tr:hover {
            background: #f8f8f8;
        }

        .success {
            color: #16a34a;
            font-weight: bold;
        }

        .error {
            color: #dc2626;
            font-weight: bold;
        }

        small {
            color: #666;
        }

        .dashboard-header {
            width: 100%;
            margin: 0 auto 30px;
            padding: 22px 1px;
            text-align: center;
            background: linear-gradient(135deg, #e4e6e9, #223d98);
            color: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .dashboard-header h1 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .dashboard-header p {
            margin-top: 8px;
            font-size: 16px;
            color: rgb(249 246 241 / 90%);
        }
        #refreshBtn {
            padding: 8px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }
        .BTN{
            display: flex;
            justify-content: end;
            margin: 0px 7px 3px 0px;
        }

    </style>

</head>

<body>
    <div class="dashboard-header">
        <h1>🚀 NestJS Application Performance Monitoring Dashboard</h1>
        <p>Real-Time API Monitoring & Request Analytics</p>
    </div>

    <div class="cards">
        <div class="card">
            <h2>
                <%= totalRequests %>
            </h2>
            <p>Total Requests</p>
        </div>

        <div class="card">
            <h2 style="color:green">
                <%= successfulRequests %>
            </h2>
            <p>Successful</p>
        </div>

        <div class="card">
            <h2 style="color:red">
                <%= failedRequests %>
            </h2>
            <p>Failed</p>
        </div>
    </div>

    <div class="BTN">
    <button id="refreshBtn" onclick="reloadLogs()">
        🔄 Refresh Logs
    </button>
    </div>


    <div class="table-container">

        <table>

            <thead>
                <tr>
                    <th>#</th>
                    <th>Request ID</th>
                    <th>Method</th>
                    <th>URL</th>
                    <th>Status Code</th>
                    <th>Response Time</th>
                    <th>Browser</th>
                    <th>Version</th>
                    <th>Operating System</th>
                    <th>Device</th>
                    <th>IP Address</th>
                    <th>Date & Time</th>
                </tr>
            </thead>

            <tbody>

                <% logs.forEach((log,index)=>{ %>

                    <tr>

                        <td>
                            <%= index + 1 %>
                        </td>

                        <td>
                            <%= log.requestId %>
                        </td>

                        <td>
                            <%= log.method %>
                        </td>

                        <td>
                            <%= log.url %>
                        </td>

                        <td class="<%= log.statusCode >= 400 ? 'error' : 'success' %>">
                            <%= log.statusCode %>
                        </td>

                        <td>
                            <%= log.responseTime %>
                        </td>

                        <td>
                            <%= log.browser %>
                        </td>

                        <td>
                            <%= log.version %>
                        </td>

                        <td>
                            <%= log.os %>
                        </td>

                        <td>
                            <%= log.device %>
                        </td>

                        <td>
                            <%= log.ip %>
                        </td>

                        <td>
                            <%= new Date(log.timestamp).toLocaleDateString('en-GB') %>
                                <br>
                                <small>
                                    <%= new Date(log.timestamp).toLocaleTimeString('en-US', { hour: '2-digit' ,
                                        minute: '2-digit' , second: '2-digit' , hour12: true }) %>
                                </small>
                        </td>

                    </tr>

                    <% }) %>

            </tbody>

        </table>

    </div>

    <script>
      function reloadLogs() {
         window.location.reload()
      }

    </script>
</body>

</html>